# Copie este ficheiro para ".env" e altere os valores.

# Endereço da API em C# (ASP.NET). Veja a porta no ficheiro launchSettings.json da API.
VITE_API_URL=https://localhost:7001/api

# true  = o site usa os dados de exemplo (não precisa da API ligada)
# false = o site faz os pedidos à API em C#
VITE_USAR_DADOS_EXEMPLO=true
