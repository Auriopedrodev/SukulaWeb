# Copie este ficheiro para ".env" e altere os valores.

# Endereço da API em C# (ASP.NET Core), sem barra no fim.
# As rotas de autenticação são /api/v1/auth/...
VITE_URL_API=http://localhost:5164

# "true"  = as outras páginas usam dados fictícios (não precisa da API ligada)
# "false" = as outras páginas usam a API verdadeira
# A autenticação (login, registo, palavra-passe) usa sempre a API.
VITE_USAR_DADOS_FICTICIOS=true
