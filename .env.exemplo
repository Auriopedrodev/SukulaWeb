# Copie este ficheiro para ".env" e altere os valores.

# Endereço da API em C# (ASP.NET Core). Termina em /api, sem barra no fim.
VITE_URL_API=https://localhost:7001/api

# "true"  = o site usa dados fictícios (não precisa da API ligada)
# "false" = o site usa a API verdadeira
VITE_USAR_DADOS_FICTICIOS=true
